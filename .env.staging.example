NODE_ENV=production
PORT=3443
CLIENT_URL=https://staging.example.com
ENABLE_HTTPS=false

MONGODB_URI=from_github_actions_secret_or_host_secret
REDIS_URL=from_github_actions_secret_or_host_secret
MEILI_HOST=from_host_secret
MEILI_MASTER_KEY=from_secret
MEILI_INDEX=devcollab_staging

OPENAI_API_KEY=from_secret
AI_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_WORKER_CONCURRENCY=2

JWT_SECRET=from_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=from_secret
REFRESH_TOKEN_EXPIRES_IN=30d
TOTP_ENCRYPTION_KEY=from_secret
TWO_FACTOR_CHALLENGE_SECRET=from_secret

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CSRF_DISABLED=false
BOT_DETECTION_MODE=monitor

PUBLIC_RATE_LIMIT_POINTS=300
PUBLIC_RATE_LIMIT_DURATION=900
USER_RATE_LIMIT_POINTS=1000
USER_RATE_LIMIT_DURATION=900
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_DURATION=900
SEARCH_RATE_LIMIT_POINTS=60
SEARCH_RATE_LIMIT_DURATION=60

GOOGLE_CLIENT_ID=from_secret
GOOGLE_CLIENT_SECRET=from_secret
GOOGLE_CALLBACK_URL=https://api-staging.example.com/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=from_secret
GITHUB_CLIENT_SECRET=from_secret
AUTH_GITHUB_CALLBACK_URL=https://api-staging.example.com/api/auth/oauth/github/callback
GITHUB_CALLBACK_URL=https://api-staging.example.com/api/github/callback
GITHUB_WEBHOOK_SECRET=from_secret
WEBHOOK_SECRET=from_secret

VITE_API_URL=https://api-staging.example.com/api
VITE_SOCKET_URL=https://api-staging.example.com
VITE_APP_NAME=DevCollab Staging
