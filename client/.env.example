# ── Client environment variables ──────────────────────────────
# Copy to .env.local for local dev overrides

# API base URL (proxied via Vite in dev, direct in prod)
VITE_API_URL=https://localhost:3443/api

# Socket.io server URL
VITE_SOCKET_URL=https://localhost:3443

# App title shown in browser tab
VITE_APP_NAME=DevCollab
